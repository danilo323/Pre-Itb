    "sobre_intro": {
        "_visible": "1",
        "info_compartido": "",
        "div_textos": "",
        "etiqueta_superior": "Trayectoria y Compromiso Educativo",
        "titulo": "Formando Líderes Prácticos con Visión de Futuro",
        "descripcion": "En ITB priorizamos una educación de alta calidad enfocada en formar pensadores innovadores. Te brindamos un entorno práctico para potenciar tus talentos más allá del salón de clases, conectándote con la comunidad y el sector laboral.\r\n\r\nCon casi 3 décadas de trayectoria desde nuestra fundación en 1996, nos hemos consolidado como un referente de educación superior en Guayaquil, abriendo las puertas para que transformes tu pasión en tu profesión.",
        "div_cita": "",
        "cita_texto": "Impulsamos una educación práctica, accesible e innovadora para formarte como el profesional que la industria necesita.",
        "cita_autor": "PhD. Elena Tolozano Benites, Rectora",
        "div_imagen": "",
        "imagen": "img/21418cd57745501d0dbda34b79eacb7e.jpg"
    },
