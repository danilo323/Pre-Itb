<IfModule mod_rewrite.c>
RewriteEngine On

# Rutas limpias del panel de administración (equivalente a router.php en local)
RewriteRule ^admin/?$ admin/index.php [L]
RewriteRule ^admin/login/?$ admin/login.php [L]
RewriteRule ^admin/logout/?$ admin/logout.php [L]
RewriteRule ^sobre-nosotros/?$ sobre-nosotros.php [L]
RewriteRule ^noticias/?$ noticias.php [L]
# Oferta Academica ya estaba enlazada en el menu, pero solo respondia con la
# extension .php: sin esta linea, /oferta-academica daba 404.
RewriteRule ^oferta-academica/?$ oferta-academica.php [L]

# Redirección amigable para páginas dinámicas personalizadas
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9\-]+)/?$ pagina_dinamica.php?route=$1 [QSA,L]

# Página 404 personalizada para cualquier URL que no exista.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ admin/404.php [L]
</IfModule>
